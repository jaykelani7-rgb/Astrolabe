# Optional. Prepared guides, tasks and known questions work without live AI.
# Choose gemini (default), lmstudio, or disabled.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional absolute database path. Default: data/mentor.sqlite
# MENTOR_DB_PATH=

# For LM Studio, use AI_PROVIDER=lmstudio. Only loopback HTTP endpoints are allowed.
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=astrolabe-coder
